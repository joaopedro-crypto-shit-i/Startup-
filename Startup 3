</div>  <!-- Modais -->  <div id="loginModal" class="modal">  
    <div class="modal-content">  
    <span class="close" onclick="closeModal('loginModal')">×</span>
        <input type="email" placeholder="E-mail" style="width:100%; padding:12px; margin:12px 0; border:1px solid #ccc; border-radius:6px;">  
        <input type="password" placeholder="Senha" style="width:100%; padding:12px; margin-bottom:20px; border:1px solid #ccc; border-radius:6px;">  
        <button class="btn-submit" onclick="login()">Entrar</button>  
    </div>  
