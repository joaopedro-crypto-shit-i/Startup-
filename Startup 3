    <div id="registerModal" class="modal">  
    <div class="modal-content">  
        <span class="close" onclick="closeModal('registerModal')">×</span>  
        <h2>Criar Nova Conta</h2>  

        <input type="text" placeholder="Nome completo" style="width:100%; padding:12px; margin:12px 0; border:1px solid #ccc; border-radius:6px;">  

        <input type="email" placeholder="E-mail" style="width:100%; padding:12px; margin-bottom:12px; border:1px solid #ccc; border-radius:6px;">  

        <input type="password" placeholder="Senha" style="width:100%; padding:12px; margin-bottom:20px; border:1px solid #ccc; border-radius:6px;">  

        <button class="btn-submit" onclick="register()">Criar Conta</button>  
    </div>  
</div>

<script>
// ================= BANCO FAKE & ESTADO ===============
let usuarios = JSON.parse(localStorage.getItem("usuarios")) || [];
let cart = [];

// ================= MODAIS =================
function openModal(id) {
    document.getElementById(id).style.display = "flex";
}

function closeModal(id) {
    document.getElementById(id).style.display = "none";
}

// ================= AUTENTICAÇÃO =================
function register() {
    const nome = document.querySelector("#registerModal input[type='text']").value;
    const email = document.querySelector("#registerModal input[type='email']").value;
    const senha = document.querySelector("#registerModal input[type='password']").value;

    if (!nome || !email || !senha) return alert("Preencha todos os campos!");

    usuarios.push({ nome, email, senha });
    localStorage.setItem("usuarios", JSON.stringify(usuarios));
    
    alert("Conta criada com sucesso! Agora faça login.");
    closeModal('registerModal');
    openModal('loginModal');
}

function login() {
    const email = document.querySelector("#loginModal input[type='email']").value;
    const senha = document.querySelector("#loginModal input[type='password']").value;

    const user = usuarios.find(u => u.email === email && u.senha === senha);

    if (user) {
        localStorage.setItem("usuarioAtual", JSON.stringify(user));
        renderizarSessao();
        closeModal('loginModal');
    } else {
        alert("E-mail ou senha incorretos!");
    }
}

function logout() {
    localStorage.removeItem("usuarioAtual");
    location.reload();
}

function renderizarSessao() {
    const user = JSON.parse(localStorage.getItem("usuarioAtual"));
    if (user) {
        document.getElementById("homeView").style.display = "none";
        document.getElementById("dashView").style.display = "block";
        document.getElementById("authBox").style.display = "none";
        document.getElementById("userName").innerText = user.nome;
    }
}

// ================= CARRINHO =================
function addToCart(name, price) {
    const existing = cart.find(item => item.name === name);
    if (existing) {
        existing.qty++;
    } else {
        cart.push({ name, price, qty: 1 });
    }
    updateCart();
}

function changeQty(index, delta) {
    cart[index].qty += delta;
    if (cart[index].qty <= 0) cart.splice(index, 1);
    updateCart();
}

function updateCart() {
    const cartItems = document.getElementById("cartItems");
    const totalPrice = document.getElementById("totalPrice");
    const cartCount = document.getElementById("cartCount");

    cartItems.innerHTML = "";
    let total = 0;
    let count = 0;

    cart.forEach((item, index) => {
        total += item.price * item.qty;
        count += item.qty;
        cartItems.innerHTML += `
            <div style="margin-bottom:12px; border-bottom:1px solid #eee; padding-bottom:8px;">
                <strong>${item.name}</strong><br>
                R$ ${item.price.toFixed(2)} x ${item.qty}
                <div style="margin-top:5px;">
                    <button onclick="changeQty(${index}, -1)">-</button>
                    <button onclick="changeQty(${index}, 1)">+</button>
                </div>
            </div>`;
    });

    totalPrice.innerText = "R$ " + total.toFixed(2);
    cartCount.innerText = count;
}

function toggleCart() {
    document.getElementById("cartDrawer").classList.toggle("active");
}

// ================= DOSAGEM (REAL-TIME) =================
function calculateDosage() {
    const weight = document.getElementById("animalWeight").value;
    const factor = document.getElementById("medType").value;
    const resultBox = document.getElementById("dosageResult");

    if (!weight || weight <= 0) {
        resultBox.innerText = "";
        return;
    }

    const dose = weight * factor;
    resultBox.innerText = "Dosagem recomendada: " + dose.toFixed(2) + " ml";
}

// ================= INICIALIZAÇÃO =================
window.onload = function() {
    renderizarSessao();
    // Adiciona ouvintes para cálculo automático de dosagem
    document.getElementById("animalWeight").addEventListener("input", calculateDosage);
    document.getElementById("medType").addEventListener("change", calculateDosage);
};
</script>
</body>
